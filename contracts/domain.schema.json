{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "秋季健康提醒规则签发簿领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "SOURCE_REGISTERED",
        "SOURCE_CORRECTED",
        "RULE_DRAFTED",
        "RULE_REVIEWED",
        "RULE_EXPIRED",
        "NOTICE_SIGNED",
        "NOTICE_SENT",
        "NOTICE_PAUSED",
        "NOTICE_EXPIRED",
        "CORRECTION_OPENED",
        "CORRECTION_DELIVERED",
        "CONSULTATION_RECORDED",
        "CONSULTATION_ESCALATED",
        "CONSULTATION_RESOLVED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "guidance_source",
        "audience_rule",
        "notice_release",
        "correction_task",
        "consultation"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "payload_required_by_event": {
    "RULE_DRAFTED": [
      "revision",
      "audience",
      "trigger_facts",
      "advice",
      "stop_self_care",
      "referral_level",
      "source_id",
      "source_version",
      "valid_until"
    ],
    "RULE_REVIEWED": [
      "audience",
      "trigger_facts"
    ],
    "NOTICE_SIGNED": [
      "rule_revision",
      "valid_until"
    ],
    "CORRECTION_OPENED": [
      "affected_release",
      "reason"
    ],
    "SOURCE_CORRECTED": [
      "source_version",
      "reason"
    ],
    "NOTICE_PAUSED": [
      "reason"
    ],
    "CONSULTATION_RECORDED": [
      "facts",
      "result"
    ],
    "CONSULTATION_ESCALATED": [
      "conflicting_keys",
      "reason"
    ],
    "CONSULTATION_RESOLVED": [
      "resolution"
    ]
  },
  "additionalProperties": false
}
